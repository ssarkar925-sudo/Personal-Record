{
  "name": "personal-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --experimental-strip-types server/index.ts",
    "start:prod": "node --experimental-strip-types server/index.ts",
    "desktop": "scripts\\launch-desktop.bat",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:backup": "node --experimental-strip-types scripts/backup-db.ts",
    "db:test": "node --experimental-strip-types scripts/test-local-db.ts",
    "backup:gdrive": "powershell -ExecutionPolicy Bypass -File scripts/sync-gdrive.ps1",
    "db:reset:clean": "node --experimental-strip-types scripts/reset-ledger.ts clean",
    "db:reset:seed": "node --experimental-strip-types scripts/reset-ledger.ts seed",
    "test": "node --experimental-strip-types --test shared/*.test.ts server/*.test.ts",
    "test:stress": "node --experimental-strip-types --test server/stress.test.ts",
    "test:maintenance": "node --experimental-strip-types --test server/db/maintenance.test.ts",
    "test:all": "node --experimental-strip-types --test server/*.test.ts server/db/*.test.ts server/watcher/*.test.ts server/sync/*.test.ts shared/*.test.ts",
    "test:prod": "node --experimental-strip-types scripts/test-production-suite.ts",
    "test:user": "node --experimental-strip-types scripts/test-real-user-journey.ts",
    "test:supabase": "node --experimental-strip-types scripts/test-live-supabase-sync.ts",
    "build:apk": "vite build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.17",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.1.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
