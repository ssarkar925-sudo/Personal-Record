# Personal Ledger - Cloud Environment Variables
# Copy this file to .env and replace with your Supabase Project Settings

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (Safe to expose in browser / Cloudflare Pages)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key (NEVER expose to frontend; only for server scripts)
# SUPABASE_SERVICE_ROLE_KEY=ey...
